# ==============================================================================
# INVITATION BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# Điền các giá trị này vào mục Environment Variables trên Render Dashboard
# ==============================================================================

# Server Port
SERVER_PORT=8080

# PostgreSQL Database Configuration
DB_URL=jdbc:postgresql://your-host:5432/neondb?sslmode=require
DB_USERNAME=your-username
DB_PASSWORD=your-password

# Security & JWT Authentication (Khóa tối thiểu 64 ký tự hex)
JWT_SECRET=your-64-character-hex-jwt-secret
JWT_EXPIRATION_MS=86400000
AES_SECRET=your-32-character-aes-key

# VietQR / Bank Account Configuration
VIETQR_BANK_ID=970432
VIETQR_BANK_NAME=VPBank
VIETQR_ACCOUNT_NO=AGBSPRUIEUW3W
VIETQR_ACCOUNT_NAME=NGUYEN QUOC KHOA

# Payment & Webhook Security Settings
PAYMENT_SANDBOX=false
PAYMENT_WEBHOOK_TOKEN=your-webhook-secret-token

# Frontend Client URL (For CORS)
CLIENT_URL=https://your-frontend-domain.onrender.com

# Render 24/7 Keep-Alive / Anti-Sleep Configuration
UPTIME_KEEP_ALIVE_ENABLED=true
APP_SERVER_PUBLIC_URL=https://your-backend-domain.onrender.com
