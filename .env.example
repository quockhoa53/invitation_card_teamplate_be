# ==============================================================================
# INVITATION BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# Sao chép file này thành .env và điền thông tin môi trường của bạn khi Deploy
# ==============================================================================

# Server Port
SERVER_PORT=8080

# PostgreSQL Database Configuration
DB_URL=jdbc:postgresql://localhost:5432/invitation_card_db
DB_USERNAME=postgres
DB_PASSWORD=1234

# Security & JWT Authentication (Khóa tối thiểu 64 ký tự)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000
AES_SECRET=MySuperSecretKeyFor2FAEnc123456

# VietQR / Bank Account Configuration
# VPBank: 970432, MBBank: 970422, Vietcombank: 970436, Techcombank: 970407, ACB: 970416...
VIETQR_BANK_ID=970432
VIETQR_BANK_NAME=VPBank
VIETQR_ACCOUNT_NO=661483903
VIETQR_ACCOUNT_NAME=NGUYEN QUOC KHOA

# Payment & Webhook Security Settings
PAYMENT_SANDBOX=false
PAYMENT_WEBHOOK_TOKEN=sepay_secret_invitation_2026

# Frontend Client URL (For CORS & Redirects)
CLIENT_URL=http://localhost:5173
